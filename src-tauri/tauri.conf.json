{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TP",
  "mainBinaryName": "TP",
  "version": "1.0.21",
  "identifier": "com.tp.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "TP",
        "width": 420,
        "height": 600,
        "minWidth": 340,
        "minHeight": 400,
        "decorations": false,
        "devtools": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "preview",
        "create": false,
        "title": "TP 预览",
        "url": "preview.html",
        "width": 420,
        "height": 200,
        "decorations": false,
        "devtools": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "large-preview",
        "create": false,
        "title": "TP 大图预览",
        "url": "large-preview.html",
        "width": 900,
        "height": 650,
        "decorations": false,
        "devtools": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "../public/third-party-notices.txt": "third-party-notices.txt"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "customLanguageFiles": {
          "SimpChinese": "installer/SimpChinese.nsh"
        },
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "installer/zh-CN.wxl"
          }
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
