{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TP",
  "mainBinaryName": "TP",
  "version": "0.5.0",
  "identifier": "com.tp.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TP",
        "width": 420,
        "height": 600,
        "minWidth": 340,
        "minHeight": 400,
        "decorations": false,
        "devtools": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "preview",
        "title": "TP 预览",
        "url": "preview.html",
        "width": 420,
        "height": 200,
        "decorations": false,
        "devtools": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "large-preview",
        "title": "TP 大图预览",
        "url": "large-preview.html",
        "width": 900,
        "height": 650,
        "decorations": false,
        "devtools": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
